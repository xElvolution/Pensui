# --- Sui contracts (live testnet deployment, 2026-06-04) ---
NEXT_PUBLIC_PACKAGE_ID=0x74436d222b29a2582531823c73e18e882d77205df2bbeb47f584249266fcc6a9
NEXT_PUBLIC_PLATFORM_ID=0xa0abdf36bac2f3c3b4014909155af0c6ac7133a28ca2e447e5edebe3827ff4ad
NEXT_PUBLIC_SUI_NETWORK=testnet

# --- Tatum (sponsor) ---
# Get a free testnet API key at https://dashboard.tatum.io
# x-api-key is injected automatically into every JSON-RPC request
NEXT_PUBLIC_TATUM_RPC=https://sui-testnet.gateway.tatum.io
NEXT_PUBLIC_TATUM_API_KEY=t-replace-with-your-tatum-testnet-key

# --- Walrus (sponsor) ---
NEXT_PUBLIC_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space

# --- PENSUI Pro (AI features paid on-chain via pensui::subscription) ---
# Wallet that receives 2 SUI / 30-day Pro subscription payments
NEXT_PUBLIC_PRO_RECIPIENT=0x17c7eff1194133626099cfa9eb6976d773fa62cc6fdd7bb05f7a2f5c3a3cc2cb
NEXT_PUBLIC_PRO_PRICE_SUI=2
NEXT_PUBLIC_PRO_DURATION_DAYS=30

# --- OpenAI (server-only — NEVER prefix with NEXT_PUBLIC_) ---
# Used by /api/ai/chat (streaming) and /api/ai/grammar.
# Get a key at https://platform.openai.com — $5 free credit on signup.
OPENAI_API_KEY=sk-proj-replace-with-your-openai-key
